node_modules/
certs/
data/photos/
data/frames/
# Staged/queued print copies and folder-mode output both contain visitor
# photos — never commit them.
data/print-jobs/
data/print-outbox/
data/*.json
# Dated copies of the runtime json files, taken before a reset or a bulk
# frame install. data/*.json above does not cover them (different suffix).
data/backups/
.DS_Store
# Firebase service-account credentials for cloud delivery (see CLOUD.md).
# Never commit the real JSON; .gitkeep keeps the folder itself in git.
secrets/*
!secrets/.gitkeep
